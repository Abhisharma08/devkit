{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "out/**",
        ".output/**",
        "dist/**"
      ],
      "env": [
        "NEXT_PUBLIC_SITE_URL",
        "CF_PAGES_URL",
        "CF_PAGES_BRANCH"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
